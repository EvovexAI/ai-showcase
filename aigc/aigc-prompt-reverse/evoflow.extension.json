{
  "schema": 1,
  "id": "aigc-prompt-reverse",
  "name": "AIGC 反推提示词工作台",
  "version": "1.0.0",
  "description": "把一条视频反推成可粘贴的文生/图生 Prompt（即梦 / Seedance / 可灵等）：粘贴链接 → 下载 → 转写 → 约 2 秒一帧关键帧 → T2V/I2V 提示词报告。全程本地，端口 8768。内容起号拆解请用 1004。",
  "icon": "./icon.svg",
  "nav": {
    "title": "AIGC 反推",
    "group": "extensions",
    "order": 62
  },
  "ui": {
    "kind": "webview",
    "entry": "http://127.0.0.1:8768",
    "sandbox": [
      "allow-scripts",
      "allow-same-origin",
      "allow-forms",
      "allow-popups"
    ]
  },
  "permissions": [
    "embed"
  ],
  "service": {
    "mode": "managed",
    "cwd": ".",
    "link": true,
    "hint": "启动本地 AIGC 反推服务（端口 8768）。首次运行需先装依赖：python -m pip install -r requirements.txt，并确保 ffmpeg 已加入 PATH。",
    "start": {
      "windows": ["python", "scripts/web_server.py"],
      "default": ["python", "scripts/web_server.py"]
    },
    "healthcheck": {
      "url": "http://127.0.0.1:8768",
      "timeout_ms": 60000
    },
    "stop": "port",
    "ports": [8768]
  },
  "bridge": {
    "origin_allowlist": [
      "http://127.0.0.1:8768",
      "http://localhost:8768"
    ]
  }
}
