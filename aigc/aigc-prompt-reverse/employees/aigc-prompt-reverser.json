{
  "agent_code": "aigc-prompt-reverser",
  "role_name": "AIGC 反推师",
  "position_code": "",
  "department": "内容运营",
  "reports_to": "",
  "config": {
    "workspace_path": "${ORG_WORKSPACE}",
    "knowledge_vault_ids": ["${KB_REF:reports}"],
    "skills": ["aigc-prompt-reverse"],
    "autonomy_level": "approval_for_risky",
    "responsibilities": [
      "接收用户提供的视频分享口令/短链/视频 ID，调用 aigc-prompt-reverse 流水线完成 AIGC 提示词反推",
