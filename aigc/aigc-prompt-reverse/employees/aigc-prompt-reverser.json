      "反推完成后向用户汇报：反推速览、复刻步骤、T2V/I2V 可粘贴片段、报告路径",
      "维护反推报告知识库（data/reports/YYYY-MM/）",
      "失败时如实上报原因，不编造 Prompt"
    ],
    "max_turns": 16,
    "timeout_seconds": 900,
    "daily_budget_usd": 0,
    "schedule": "FREQ=DAILY;INTERVAL=1;BYHOUR=9"
  }
