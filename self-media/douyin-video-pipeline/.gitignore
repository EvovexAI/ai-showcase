# 依赖
node_modules/
__pycache__/
*.egg-info/
.venv/
venv/
env/

# 本地环境
.env
.env.local
config/.env
config/*.local.json
.DS_Store

# 构建产物
dist/
build/
*.pyc
*.pyo

# IDE
.vscode/
.cursor/
.idea/
*.swp
*.swo

# 媒体和临时数据（保留代码和脚本）
# 注意：gitignore 不支持行内注释，注释必须独占一行
# data/ 是全部运行时数据（视频/报告/下载/上传/生成物）——导出项目时整体排除即可
/data/
*.mp4
*.m4a
*.wav
*.mp3
*.jpg
*.jpeg
*.png
*.gif
*.webm
data/_tmp_ytdlp/
data/ANALYSIS_*.md
data/reports/_tmp/
videos/
reports/
downloads/
uploads/
outputs/

# 数据库和缓存
*.db
*.sqlite
.cache/

# 日志
*.log
logs/

# Agent 元数据（不应入仓）
.cursor/
.evoflow/
