      {
        "ref": "reports",
        "name": "抖音博主报告库",
        "description": "博主账号分析报告（data/reports）",
        "import_folder": "./data/reports",
        "upsert": true,
        "prune_missing": false
      }
    ],
    "skills": [
      { "path": "./skills/douyin-blogger-analysis", "link": true }
    ],
    "agents": [
      { "from": "./agents/douyin-blogger-analyst.yaml" }
    ],
    "extensions": [
      { "from": "./", "link": true }
    ]
  },
  "team": {
    "employees": [
      { "from": "./employees/douyin-blogger-analyst.json" }
    ]
  }
