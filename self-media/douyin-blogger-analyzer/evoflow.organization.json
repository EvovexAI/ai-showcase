{
  "schema": 1,
  "kind": "team",
  "id": "douyin-blogger-analyzer-pack",
  "name": "抖音博主分析场景包",
  "version": "1.0.0",
  "description": "1005 博主分析全套：面板扩展（folder-link）+ 博主分析师员工 + 采集技能（folder-link）+ 博主报告知识库。一次导入即可装配。",
