# VolcEngine TTS Configuration
# Copy this file to .env and fill in your real API key

# Get your API key from: https://www.volcengine.com/product/voice-tech
VOLCENGINE_API_KEY=your-volcengine-api-key-here

# Optional: customize TTS settings
TTS_RESOURCE_ID=seed-tts-2.0
TTS_SPEAKER=zh_female_xiaohe_uranus_bigtts
