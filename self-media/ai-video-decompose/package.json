{
  "name": "ai-video-decompose",
  "version": "1.0.0",
  "description": "AI 视频拆解服务 - 抖音视频一键分析",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter ai-video-decompose-web dev",
    "dev:api": "pnpm --filter ai-video-decompose-api dev",
    "dev:web": "pnpm --filter ai-video-decompose-web dev",
    "build": "pnpm --filter ai-video-decompose-api build && pnpm --filter ai-video-decompose-web build",
    "start": "pnpm --filter ai-video-decompose-web start",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@prisma/client": "^5.22.0",
    "fastify": "^5.1.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "swr": "^2.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0"
}
